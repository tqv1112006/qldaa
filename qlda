<div class="project-modal" id="projectDetailModal" onclick="if(event.target===this) closeProjectModal()">
  <div class="modal-card">
    <div class="modal-header">
      <h3 id="modalProjectTitle" style="font-size: 1.15rem;">Chi tiết Dự án</h3>
      <button class="btn-icon" onclick="closeProjectModal()"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="modal-body" id="modalProjectBody">
      <!-- Body populated via app.js -->
    </div>
  </div>
</div>

<!-- ==============================================================================
     MODAL: PRESENTATION SLIDE DECK (18 SLIDES)
     ============================================================================== -->
<div class="slide-deck-modal" id="slideDeckModal">
  <div class="slide-deck-header">
    <div style="display: flex; align-items: center; gap: 1rem;">
      <span style="font-weight: 800; font-family: var(--font-heading); color: var(--accent-cyan); font-size: 1.1rem;">
        <i class="fa-solid fa-plane-departure"></i> T2 NỘI BÀI
      </span>
      <span style="color: rgba(255,255,255,0.4);">|</span>
      <span style="font-size: 0.88rem; color: #CBD5E1;">Thẩm định Dự án Đầu tư & Đánh đổi Mục tiêu</span>
    </div>
    <div style="display: flex; align-items: center; gap: 1rem;">
      <span class="slide-counter" id="slideCounterDisplay">01 / 18</span>
      <button class="btn-icon" style="background: rgba(255,255,255,0.1); color: white;" onclick="toggleFullscreen()" title="Toàn màn hình (F)">
        <i class="fa-solid fa-expand"></i>
      </button>
      <button class="btn-icon" style="background: rgba(255,255,255,0.1); color: white;" onclick="closeSlideDeck()" title="Đóng Slide (Esc)">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
  </div>

  <div class="slide-stage-container">
    <div class="slide-canvas">
      <div>
        <div class="slide-kicker" id="slideKicker">KICKER</div>
        <h2 id="slideTitle">Slide Title</h2>
        <p id="slideSubtitle" style="color: #94A3B8; font-size: 1rem; margin-bottom: 1.25rem;">Slide Subtitle</p>
      </div>

      <div class="slide-body-content" id="slideBody">
        <!-- Injected dynamically -->
      </div>

      <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 0.75rem; font-size: 0.8rem; color: #64748B;">
        <span>Case Study: Mở rộng Nhà ga T2 Nội Bài – Mô hình Đánh đổi Mục tiêu C1</span>
        <span>Sử dụng phím ◄ / ► hoặc Phím cách để chuyển slide</span>
      </div>
    </div>
  </div>

  <div class="slide-deck-footer">
    <button class="slide-ctrl-btn" onclick="prevSlide()" title="Slide trước (◄)"><i class="fa-solid fa-chevron-left"></i></button>
    <button class="slide-ctrl-btn" onclick="nextSlide()" title="Slide kế tiếp (►)"><i class="fa-solid fa-chevron-right"></i></button>
    <button class="btn btn-outline" onclick="closeSlideDeck()" style="color: white; border-color: rgba(255,255,255,0.25); background: transparent;">
      <i class="fa-solid fa-house"></i> Dashboard
    </button>
  </div>
</div>

<!-- Custom Scripts -->
<script src="app.js"></script>

